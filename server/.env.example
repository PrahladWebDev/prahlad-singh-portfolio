# Copy to server/.env on the VPS and fill in. NEVER commit .env
PORT=4000

# Gmail account that SENDS the mails (and receives them unless MAIL_TO is set)
GMAIL_USER=prahlad.singh.dev@gmail.com
# Google "App password" (16 chars) - NOT your normal Gmail password.
# Create at https://myaccount.google.com/apppasswords (2-Step Verification must be on)
GMAIL_APP_PASSWORD=

# Optional: where notifications go (defaults to GMAIL_USER)
MAIL_TO=

# Secret used to delete guestbook entries: curl -X DELETE -H "Authorization: Bearer <token>" /api/guestbook/<id>
ADMIN_TOKEN=change-me-to-a-long-random-string

# Only needed if the API is served from a different origin than the site
ALLOWED_ORIGIN=https://prahladsingh.in
